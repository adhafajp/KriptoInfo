# Salin menjadi .env dan isi nilai rahasia sendiri.
PORT=3001
NODE_ENV=development

# XAMPP MariaDB
DATABASE_URL="mysql://root:@127.0.0.1:3306/kryptoinfo"

# Frontend Vite
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173

# Wajib: 32 byte / 64 karakter hex. Jangan commit .env.
ENCRYPTION_KEY=

# Wajib diisi untuk mengizinkan enrollment pengguna pertama.
ENROLLMENT_CODE=ganti-dengan-kode-rahasia-panjang

# Cookie sesi
SESSION_COOKIE_NAME=kryptoinfo.sid
SESSION_TTL_HOURS=8

# Batas jarak Euclidean descriptor wajah (0.35 untuk keamanan ketat anti-spoof/beda orang).
FACE_MATCH_THRESHOLD=0.35
